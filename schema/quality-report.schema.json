{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qualityreporter.dev/schemas/quality-report.schema.json",
  "title": "QualityReporter v1.4 report",
  "type": "object",
  "required": [
    "schemaVersion",
    "language",
    "generatedAt",
    "repository",
    "summary",
    "files",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "language": {
      "enum": [
        "csharp",
        "typescript"
      ]
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "type": "object"
    },
    "summary": {
      "type": "object"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trend": {
      "type": [
        "object",
        "null"
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "duplicates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/duplicateGroup"
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "required": [
        "path",
        "metrics",
        "history",
        "activity",
        "risk",
        "hotspot",
        "recommendations",
        "couplings",
        "functions"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "metrics": {
          "type": "object"
        },
        "history": {
          "type": "object"
        },
        "activity": {
          "type": "object",
          "required": [
            "score",
            "maturityFactor",
            "effectiveScore"
          ]
        },
        "risk": {
          "type": "object",
          "required": [
            "score",
            "level"
          ]
        },
        "hotspot": {
          "type": "object",
          "required": [
            "priorityScore",
            "classifications"
          ]
        },
        "recommendations": {
          "type": "array"
        },
        "couplings": {
          "type": "array"
        },
        "functions": {
          "type": "array"
        },
        "symbols": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/symbol"
          }
        },
        "methodSummary": {
          "type": [
            "object",
            "null"
          ]
        },
        "scores": {
          "$ref": "#/$defs/scores"
        }
      }
    },
    "symbol": {
      "type": "object",
      "required": [
        "symbolId",
        "symbolKey",
        "name",
        "kind",
        "location",
        "metrics",
        "history",
        "activity",
        "risk",
        "hotspot",
        "couplings",
        "recommendations"
      ],
      "properties": {
        "symbolId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "symbolKey": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "location": {
          "type": "object",
          "required": [
            "startLine",
            "endLine"
          ],
          "properties": {
            "startLine": {
              "type": "integer",
              "minimum": 1
            },
            "endLine": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "metrics": {
          "type": "object",
          "required": [
            "loc",
            "complexity"
          ]
        },
        "history": {
          "type": "object"
        },
        "activity": {
          "type": "object"
        },
        "risk": {
          "type": "object"
        },
        "hotspot": {
          "type": "object"
        },
        "couplings": {
          "type": "array"
        },
        "recommendations": {
          "type": "array"
        },
        "scores": {
          "$ref": "#/$defs/scores"
        }
      }
    },
    "duplicateGroup": {
      "type": "object",
      "required": [
        "id",
        "lines",
        "tokens",
        "fragments"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "lines": {
          "type": "integer",
          "minimum": 0
        },
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "fragments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "startLine",
              "endLine"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "startLine": {
                "type": "integer",
                "minimum": 1
              },
              "endLine": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "axisScore": {
      "type": "object",
      "required": [
        "score",
        "level",
        "components",
        "availableWeight"
      ],
      "properties": {
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "level": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical",
            "unknown"
          ]
        },
        "components": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "availableWeight": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "scores": {
      "type": "object",
      "required": [
        "activity",
        "maintainability",
        "testability",
        "architecture",
        "overallQuality",
        "hotspotPriority"
      ],
      "properties": {
        "activity": {
          "$ref": "#/$defs/axisScore"
        },
        "maintainability": {
          "$ref": "#/$defs/axisScore"
        },
        "testability": {
          "$ref": "#/$defs/axisScore"
        },
        "architecture": {
          "$ref": "#/$defs/axisScore"
        },
        "knowledge": {
          "$ref": "#/$defs/axisScore"
        },
        "overallQuality": {
          "$ref": "#/$defs/axisScore"
        },
        "hotspotPriority": {
          "$ref": "#/$defs/axisScore"
        }
      }
    }
  }
}
