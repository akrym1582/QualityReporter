{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qualityreporter.dev/schemas/quality-config.schema.json",
  "title": "QualityReporter v1.5 configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "trend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "windowRuns": { "type": "integer", "minimum": 4, "default": 8 },
        "minimumSamples": { "type": "integer", "minimum": 4, "default": 4 }
      }
    },
    "historyDays": {
      "type": "integer"
    },
    "reworkWindowDays": {
      "type": "integer"
    },
    "exclude": {
      "type": "array"
    },
    "coupling": {
      "type": "object"
    },
    "fileMaturity": {
      "type": "object"
    },
    "activityWeights": {
      "type": "object"
    },
    "riskWeights": {
      "type": "object"
    },
    "classification": {
      "type": "object"
    },
    "functions": {
      "type": "object"
    },
    "report": {
      "type": "object"
    },
    "methodAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "historyEnabled": {
          "type": "boolean"
        },
        "includeConstructors": {
          "type": "boolean"
        },
        "includeAccessors": {
          "type": "boolean"
        },
        "includeLocalFunctions": {
          "type": "boolean"
        },
        "includeAnonymousFunctions": {
          "type": "boolean"
        },
        "countLogicalOperators": {
          "type": "boolean"
        },
        "complexityWarning": {
          "type": "integer",
          "minimum": 1
        },
        "complexityCritical": {
          "type": "integer",
          "minimum": 1
        },
        "coupling": {
          "type": "object"
        },
        "renameTracking": {
          "type": "object"
        }
      }
    },
    "untestedComplexity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "coverageMode": {
          "enum": [
            "line",
            "branch",
            "combined"
          ]
        },
        "complexityWarning": {
          "type": "integer",
          "minimum": 1
        },
        "complexityCritical": {
          "type": "integer",
          "minimum": 1
        },
        "lowCoverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "criticalCoverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "duplication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "reportPath": {
          "type": "string"
        },
        "warningPercentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "strongPercentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimumLines": {
          "type": "integer",
          "minimum": 1
        },
        "minimumTokens": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "qualityAxes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maintainability": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "includeInOverallRisk": {
              "type": "boolean"
            },
            "weights": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "complexity": {
                  "type": "number",
                  "minimum": 0
                },
                "rework": {
                  "type": "number",
                  "minimum": 0
                },
                "duplication": {
                  "type": "number",
                  "minimum": 0
                },
                "issues": {
                  "type": "number",
                  "minimum": 0
                },
                "methodSize": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        },
        "testability": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "includeInOverallRisk": {
              "type": "boolean"
            },
            "weights": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "untestedComplexity": {
                  "type": "number",
                  "minimum": 0
                },
                "lineCoverage": {
                  "type": "number",
                  "minimum": 0
                },
                "branchCoverage": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        },
        "architecture": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "includeInOverallRisk": {
              "type": "boolean"
            },
            "weights": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "changeCoupling": {
                  "type": "number",
                  "minimum": 0
                },
                "issues": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        },
        "knowledge": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "includeInOverallRisk": {
              "type": "boolean"
            },
            "weights": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ownershipConcentration": {
                  "type": "number",
                  "minimum": 0
                },
                "authorDiversity": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "overallRisk": {
      "type": "object",
      "properties": {
        "weights": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maintainability": {
              "type": "number",
              "minimum": 0
            },
            "testability": {
              "type": "number",
              "minimum": 0
            },
            "architecture": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
